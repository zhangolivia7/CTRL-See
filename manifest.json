{
    "manifest_version": 3,
    "name": "CTRL-See",
    "version": "1.0",
    "description": "Tracks your copy history.",
    "permissions": ["clipboardRead", "storage"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
      }
    }
  }
  